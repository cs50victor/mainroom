# Local/dev Clerk secret key used by the backend when AUTH_MODE=clerk.
# Keep this pointed at the development Clerk instance.
CLERK_SECRET_KEY=replace-with-dev-clerk-secret-key

# Production Clerk secret key.
# GitHub Actions should store this value as the secret named CLERK_SECRET_KEY,
# because wrangler deploy passes that exact secret name into the container.
CLERK_SECRET_KEY_PROD=replace-with-prod-clerk-secret-key

# Optional Clerk Backend API overrides. The SDK appends CLERK_API_VERSION to
# CLERK_API_URL, so keep CLERK_API_URL at the origin rather than /v1.
CLERK_API_URL=https://api.clerk.com
CLERK_API_VERSION=v1

# Auth mode. Local/dev defaults to mock, production defaults to clerk.
# Use AUTH_MODE=clerk locally when testing real Clerk API key verification.
AUTH_MODE=mock

# Cloudflare account ID from the dashboard API panel or `wrangler whoami --json`.
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id

# Cloudflare custom API token for GitHub deploys.
# Create one in Cloudflare: My Profile > API Tokens > Create Custom Token.
# Required permissions for mainroom.sh:
# - Account > Containers > Edit
# - Account > Workers Scripts > Edit
# - Zone > Zone > Read
# - Zone > Workers Routes > Edit
# - Zone > DNS > Edit
CLOUDFLARE_API_TOKEN=replace-with-cloudflare-api-token

# Cloudflare zone ID for mainroom.sh.
# Find it in the mainroom.sh dashboard sidebar API panel.
CLOUDFLARE_ZONE_ID=replace-with-cloudflare-zone-id

# Internal token for machine lifecycle endpoints on the Worker control plane.
MACHINE_CONTROL_TOKEN=replace-with-machine-control-token

# R2 bucket mounted by every user machine container.
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_BUCKET_NAME=mainroom-user-machines
AWS_ACCESS_KEY_ID=replace-with-r2-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
