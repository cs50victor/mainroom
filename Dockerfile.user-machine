FROM oven/bun:1 AS base
WORKDIR /usr/src/app

FROM base AS install
RUN mkdir -p /temp/dev /temp/prod
COPY package.json bun.lock /temp/dev/
RUN cd /temp/dev && bun install --frozen-lockfile
COPY package.json bun.lock /temp/prod/
RUN cd /temp/prod && bun install --frozen-lockfile --production

FROM base AS prerelease
COPY --from=install /temp/dev/node_modules node_modules
COPY . .
ENV NODE_ENV=production
RUN bun run typecheck

FROM base AS release
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl tar \
  && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
  arch="$(uname -m)"; \
  case "$arch" in \
    x86_64) target="x86_64-unknown-linux-gnu" ;; \
    aarch64) target="aarch64-unknown-linux-gnu" ;; \
    *) echo "unsupported architecture: ${arch}" >&2; exit 1 ;; \
  esac; \
  version="$(curl -fsSL https://api.github.com/repos/cs50victor/tokenproxy/releases/latest | sed -n 's/.*"tag_name": "\(v[^"]*\)".*/\1/p' | head -n 1)"; \
  curl -fsSL "https://github.com/cs50victor/tokenproxy/releases/download/${version}/tokenproxy-${version}-${target}.tar.gz" -o /tmp/tokenproxy.tar.gz; \
  tar -xzf /tmp/tokenproxy.tar.gz -C /tmp; \
  mv "/tmp/tokenproxy-${version}-${target}/tokenproxy" /usr/local/bin/tokenproxy; \
  rm -rf /tmp/tokenproxy.tar.gz "/tmp/tokenproxy-${version}-${target}"; \
  chmod +x /usr/local/bin/tokenproxy; \
  tokenproxy --version

COPY --from=install /temp/prod/node_modules node_modules
COPY --from=prerelease /usr/src/app/src src
COPY --from=prerelease /usr/src/app/package.json package.json

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000/tcp
ENTRYPOINT ["bun", "run", "src/index.ts"]
