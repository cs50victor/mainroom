{
  "name": "mainroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "bun run --watch src/index.ts",
    "lint": "prettier --check --ignore-unknown .",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json"
  },
  "dependencies": {
