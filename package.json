{
  "name": "mainroom",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "bin": {
    "mainroom": "cli/mainroom.ts"
  },
  "scripts": {
    "build:cli:linux": "bun build --compile --minify --target=bun-linux-x64 cli/mainroom.ts --outfile dist/mainroom-linux-x64",
    "build:cli:linux-arm": "bun build --compile --minify --target=bun-linux-arm64 cli/mainroom.ts --outfile dist/mainroom-linux-arm64",
    "build:cli:macos": "bun build --compile --minify --target=bun-darwin-x64 cli/mainroom.ts --outfile dist/mainroom-darwin-x64",
    "build:cli:macos-arm": "bun build --compile --minify --target=bun-darwin-arm64 cli/mainroom.ts --outfile dist/mainroom-darwin-arm64",
    "build:cli:all": "bun run build:cli:linux && bun run build:cli:linux-arm && bun run build:cli:macos && bun run build:cli:macos-arm",
    "cli": "bun run cli/mainroom.ts",
    "deploy": "wrangler deploy",
    "dev": "bun run build:css && concurrently --kill-others \"bun run dev:css\" \"bun run dev:server\"",
    "lint": "prettier --check --ignore-unknown .",
    "start": "bun run build:css && bun run src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "build:css": "tailwindcss -i src/site/tailwind.css -o src/generated/site.css --minify",
    "dev:css": "tailwindcss -i src/site/tailwind.css -o src/generated/site.css --watch=always",
    "dev:server": "bun run --watch src/index.ts"
  },
  "dependencies": {
    "@clerk/backend": "3.7.1",
    "@inquirer/prompts": "^8.5.2",
    "@scalar/hono-api-reference": "^0.11.3",
    "aws4fetch": "^1.0.20",
    "commander": "^15.0.0",
    "fast-xml-parser": "^5.9.3",
    "hono": "^4.12.25",
    "hono-zod-openapi": "^1.1.1",
    "marked": "^18.0.11",
    "oauth4webapi": "^3.8.6",
    "smol-toml": "^1.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/workers-types": "^4.20260616.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/bun": "^1.3.14",
    "concurrently": "^10.0.5",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.100.0"
  }
}
