    "hono": "^4.12.25",
    "hono-zod-openapi": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/workers-types": "^4.20260616.1",
    "@types/bun": "^1.3.14",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "wrangler": "^4.100.0"
  }
}
