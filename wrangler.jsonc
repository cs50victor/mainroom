{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mainroom",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-16",
  "workers_dev": false,
  "observability": {
    "enabled": true,
  },
  "routes": [
    {
      "pattern": "mainroom.sh/*",
      "zone_name": "mainroom.sh",
    },
    {
      "pattern": "*.mainroom.sh/*",
      "zone_name": "mainroom.sh",
    },
  ],
  "vars": {
    "CLERK_OAUTH_AUTHORIZE_URL": "https://clerk.mainroom.sh/oauth/authorize",
    "CLERK_OAUTH_CLIENT_ID": "Bvbh1z5AiDEw6Mwm",
    "CLERK_OAUTH_TOKEN_URL": "https://clerk.mainroom.sh/oauth/token",
    "CORS_ORIGIN": "https://mainroom.sh",
    "FLY_APP_HOSTNAME": "mainroom-user-machines.fly.dev",
    "FLY_APP_NAME": "mainroom-user-machines",
    "FLY_MACHINE_REGION": "iad",
    "FLY_TOKENPROXY_IMAGE": "registry.fly.io/mainroom-user-machines:tokenproxy-v0.1.16",
  },
  "secrets": {
    "required": [
      "AWS_ACCESS_KEY_ID",
      "AWS_SECRET_ACCESS_KEY",
      "CLERK_PUBLISHABLE_KEY",
      "CLERK_SECRET_KEY",
      "FLY_API_TOKEN",
      "MACHINE_CONTROL_TOKEN",
      "S3_BUCKET",
      "S3_ENDPOINT",
      "S3_REGION",
    ],
  },
  "containers": [
    {
      "class_name": "MainroomContainer",
      "image": "./Dockerfile",
      "instance_type": "lite",
      "max_instances": 3,
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "MainroomContainer",
        "name": "MAINROOM_CONTAINER",
      },
      {
        "class_name": "UserMachineContainer",
        "name": "USER_MACHINE_CONTAINER",
      },
      {
        "class_name": "ShareGrantStore",
        "name": "SHARE_GRANT_STORE",
      },
    ],
  },
  "migrations": [
    {
      "new_sqlite_classes": ["MainroomContainer"],
      "tag": "v1",
    },
    {
      "new_sqlite_classes": ["UserMachineContainer"],
      "tag": "v2",
    },
    {
      "new_sqlite_classes": ["ShareGrantStore"],
      "tag": "v3",
    },
  ],
}
